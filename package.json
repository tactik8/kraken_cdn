{
  "name": "kraken_cdn",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm",
    "build:cjs": "esbuild src/index.js --bundle --packages=external --sourcemap --minify --platform=node --format=cjs --outfile=dist/index.cjs",
    "build:esm": "esbuild src/index.js --bundle --packages=external --sourcemap --minify --platform=node --format=esm --outfile=dist/index.js",
    "dev": "node src/server.js",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "Tactik8",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.3.0"
  }
}
